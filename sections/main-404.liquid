<style type="text/css">
  .template-404-custom {
    position: relative;
    background-color: #fff; /* fallback */
    color: {{ section.settings.text_color | default: '#000000' }};
    min-height: calc(100vh - var(--header-height, 100px));
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .template-404-custom .page-width {
    position: relative;
    z-index: 2;
    padding-left: 5rem;
  }
  .template-404__subtitle {
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
    color: {{ section.settings.text_color | default: '#000000' }};
    opacity: 0.8;
    font-family: var(--font-body-family);
  }
  .template-404__title {
    font-size: 5rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 4rem;
    color: {{ section.settings.text_color | default: '#000000' }};
    font-family: var(--font-heading-family);
    letter-spacing: -0.02em;
  }
  .template-404__button {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color | default: '#000000' }};
    color: {{ section.settings.button_text_color | default: '#ffffff' }};
    padding: 1.2rem 3.5rem;
    border-radius: 4rem;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 600;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .template-404__button:hover {
    transform: scale(1.05);
    opacity: 0.85;
  }
  .template-404__bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    object-fit: cover;
  }
  
  @media screen and (max-width: 749px) {
    .template-404-custom .page-width {
      padding-left: 2rem;
      padding-right: 2rem;
    }
    .template-404__title {
      font-size: 3.5rem;
    }
  }
</style>

<div class="template-404-custom">
  {%- if section.settings.bg_image != blank -%}
    <img
      src="{{ section.settings.bg_image | image_url: width: 1500 }}"
      alt="{{ section.settings.bg_image.alt | escape }}"
      class="template-404__bg-image"
      loading="lazy"
      width="{{ section.settings.bg_image.width }}"
      height="{{ section.settings.bg_image.height }}"
    >
  {%- endif -%}
  
  <div class="page-width">
    <div class="template-404__subtitle">{{ section.settings.subtitle | escape }}</div>
    <h1 class="template-404__title">
      {{ section.settings.title | newline_to_br }}
    </h1>
    <a href="{{ routes.root_url }}" class="template-404__button">
      {{ section.settings.button_label | escape }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "404 - Not Found"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Oops. You've run off course ...\nHead back home to try a different route."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Home"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
