{{ 'section-expanding-carousel.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ExpandingCarousel-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
    {% endif %}
  }

  #ExpandingCarousel-{{ section.id }} .expanding-carousel__label {
    color: {{ section.settings.label_color }};
  }

  #ExpandingCarousel-{{ section.id }} .expanding-carousel__heading {
    color: {{ section.settings.heading_color }};
  }

  #ExpandingCarousel-{{ section.id }} .expanding-carousel__heading em {
    color: {{ section.settings.accent_color }};
  }

  #ExpandingCarousel-{{ section.id }} .expanding-carousel__subtitle {
    color: {{ section.settings.subtitle_color }};
  }
{%- endstyle -%}

<div class="expanding-carousel-section color-{{ section.settings.color_scheme }} isolate gradient section-{{ section.id }}-padding" id="ExpandingCarousel-{{ section.id }}">
  <div class="page-width">
    <!-- Header Section with Controls -->
    <div class="expanding-carousel__header">
      <div class="expanding-carousel__header-left">
        {%- if section.settings.label != blank -%}
          <span class="expanding-carousel__label">{{ section.settings.label }}</span>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="expanding-carousel__heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="expanding-carousel__subtitle">
            {{ section.settings.subtitle }}
          </p>
        {%- endif -%}
      </div>

      <div class="expanding-carousel__controls">
        <button type="button" class="expanding-carousel__btn expanding-carousel__btn--prev" aria-label="Previous slide">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.2" fill="none">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="expanding-carousel__btn expanding-carousel__btn--next" aria-label="Next slide">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.2" fill="none">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Expanding Carousel Container -->
    <div class="expanding-carousel-container">
      <div class="expanding-carousel" id="ExpandingCarouselTrack-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_active = false
            if forloop.first
              assign is_active = true
            endif

            assign overlay_opacity = block.settings.overlay_opacity | default: 40 | divided_by: 100.0
          -%}
          <div
            class="expanding-card{% if is_active %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            style="
              --card-text-custom: {{ block.settings.text_color }};
              --card-btn-bg-custom: {{ block.settings.btn_bg }};
              --card-btn-text-custom: {{ block.settings.btn_text }};
              --overlay-val: {{ overlay_opacity }};
            "
            {{ block.shopify_attributes }}
          >
            <div class="expanding-card__bg">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1400 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  class="expanding-card__img"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- else -%}
                <div class="expanding-card__placeholder">
                  {%- assign placeholder_idx = forloop.index | modulo: 3 | plus: 1 -%}
                  {{ 'collection-' | append: placeholder_idx | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
              <div class="expanding-card__overlay"></div>
            </div>

            <!-- Bottom Left Aligned Content -->
            <div class="expanding-card__content">
              <div class="expanding-card__bottom-wrap">
                {%- if block.settings.number != blank -%}
                  <span class="expanding-card__number">{{ block.settings.number }}</span>
                {%- endif -%}

                <h3 class="expanding-card__title">{{ block.settings.title }}</h3>
                <p class="expanding-card__desc">{{ block.settings.description }}</p>
                
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.link | default: '#' }}" class="expanding-card__btn">
                    <span>{{ block.settings.button_label }}</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.2" fill="none">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initExpandingCarousel(section) {
      if (!section) return;

      const cards = Array.from(section.querySelectorAll('.expanding-card'));
      const prevBtn = section.querySelector('.expanding-carousel__btn--prev');
      const nextBtn = section.querySelector('.expanding-carousel__btn--next');
      const track = section.querySelector('.expanding-carousel');

      if (!cards.length) return;

      let activeIndex = 0;

      function setActiveCard(index) {
        cards.forEach((card, i) => {
          if (i === index) {
            card.classList.add('is-active');
            if (window.innerWidth < 750) {
              card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          } else {
            card.classList.remove('is-active');
          }
        });
        activeIndex = index;
      }

      cards.forEach((card, index) => {
        card.addEventListener('click', function() {
          setActiveCard(index);
        });
      });

      nextBtn?.addEventListener('click', function(e) {
        e.preventDefault();
        const nextIndex = (activeIndex + 1) % cards.length;
        setActiveCard(nextIndex);
      });

      prevBtn?.addEventListener('click', function(e) {
        e.preventDefault();
        const prevIndex = (activeIndex - 1 + cards.length) % cards.length;
        setActiveCard(prevIndex);
      });

      // Mobile Touch Swipe Drag Gestures
      let touchStartX = 0;
      let touchEndX = 0;

      if (track) {
        track.addEventListener('touchstart', function(e) {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        track.addEventListener('touchend', function(e) {
          touchEndX = e.changedTouches[0].screenX;
          const diffX = touchEndX - touchStartX;
          if (Math.abs(diffX) > 30) {
            if (diffX < 0) {
              // Swipe Left -> Next Slide
              const nextIndex = (activeIndex + 1) % cards.length;
              setActiveCard(nextIndex);
            } else {
              // Swipe Right -> Prev Slide
              const prevIndex = (activeIndex - 1 + cards.length) % cards.length;
              setActiveCard(prevIndex);
            }
          }
        }, { passive: true });
      }
    }

    function setup() {
      const section = document.getElementById('ExpandingCarousel-{{ section.id }}');
      if (section) initExpandingCarousel(section);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        setup();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Expanding Carousel",
  "class": "section-expanding-carousel-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "default": "transparent",
      "label": "Section Background Color"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Section Background Image"
    },
    {
      "type": "text",
      "id": "label",
      "default": "LOOKBOOK & ESSENTIALS",
      "label": "Small Top Label"
    },
    {
      "type": "color",
      "id": "label_color",
      "default": "#CBD64A",
      "label": "Label Color"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Stories in <em>Motion</em>",
      "label": "Heading (Use italic for accent)"
    },
    {
      "type": "color",
      "id": "heading_color",
      "default": "#111111",
      "label": "Heading Main Text Color"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#CBD64A",
      "label": "Heading Accent Color"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "default": "Explore our high-performance editorial collections",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "default": "#666666",
      "label": "Subheading Text Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Slide Number",
          "default": "01 /"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Slide Title",
          "default": "Contrast"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Slide Description",
          "default": "Dark tailoring, clean space, and metallic detail give the composition strength, tension, and precision."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Explore Collection"
        },
        {
