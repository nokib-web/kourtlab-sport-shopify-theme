      "label": "Padding Bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Upload Custom Icon (PNG, SVG, WebP)"
        },
        {
          "type": "html",
