          "default": "crown"
        },
        {
          "type": "text",
          "id": "title",
          "default": "LIFETIME FOUNDING STATUS",
          "label": "Perk Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "default": "Your name in our history.",
          "label": "Perk Subtitle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KØRĒ Founding 1000 VIP",
      "blocks": [
        {
          "type": "perk",
          "settings": {
            "icon": "crown",
            "title": "LIFETIME FOUNDING STATUS",
            "subtitle": "Your name in our history."
          }
        },
        {
          "type": "perk",
          "settings": {
            "icon": "clock",
            "title": "EARLY ACCESS TO EVERY DROP",
