          }
        },
        {
          "type": "perk",
          "settings": {
            "icon": "star_badge",
            "title": "EXCLUSIVE PRODUCTS",
            "subtitle": "Founding 1000 only."
          }
        },
        {
          "type": "perk",
          "settings": {
            "icon": "gift",
            "title": "PREMIUM WELCOME GIFT",
            "subtitle": "Curated. Limited. For you."
          }
        },
        {
          "type": "perk",
          "settings": {
            "icon": "ticket",
            "title": "MEMBERS-ONLY EVENTS",
            "subtitle": "Connect. Play. Repeat."
          }
        }
      ]
    }
  ]
}
{% endschema %}
