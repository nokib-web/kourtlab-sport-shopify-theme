          "label": "Or Choose Default Icon",
          "options": [
            { "value": "crown", "label": "Star / Ribbon (Founding Status)" },
            { "value": "clock", "label": "Clock (Early Access / 48h)" },
            { "value": "star_badge", "label": "Star Badge (Exclusive Products)" },
