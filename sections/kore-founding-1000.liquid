{%- style -%}
  .kore-founding-1000--{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#F8F8F6' }};
    position: relative;
    padding-top: {{ section.settings.padding_top | default: 72 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 72 }}px;
    overflow: hidden;
    width: 100%;
    color: {{ section.settings.text_color | default: '#0A0A0A' }};
  }

  /* Grid Layout */
  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__grid {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 4.5rem;
  }

  /* Left Column */
  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__left {
    flex: 0 0 48%;
    max-width: 48%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Clean, Sharp Main Heading */
  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4.2vw, 3.8rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: {{ section.settings.text_color | default: '#0A0A0A' }};
    margin: 0 0 1.5rem 0;
  }

  /* Description with Accent Bar */
  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__desc-wrap {
    border-left: 3px solid {{ section.settings.accent_color | default: '#CBD64A' }};
    padding-left: 1.25rem;
    margin-bottom: 2.25rem;
    max-width: 520px;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__desc {
    font-family: var(--font-body-family);
    font-size: {{ section.settings.description_font_size | default: 18 }}px;
    line-height: 1.6;
    font-weight: 400;
    color: {{ section.settings.muted_text_color | default: '#333333' }};
    margin: 0;
  }

  /* Brutal Button */
  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: {{ section.settings.button_bg | default: '#CBD64A' }};
    color: #0A0A0A;
    padding: 1rem 2.25rem;
    font-family: var(--font-heading-family);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid {{ section.settings.border_color | default: '#0A0A0A' }};
    box-shadow: 4px 4px 0px {{ section.settings.border_color | default: '#0A0A0A' }};
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    margin-bottom: 2.75rem;
    cursor: pointer;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px {{ section.settings.border_color | default: '#0A0A0A' }};
    background-color: #d8e452;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__btn svg {
    width: 18px;
    height: 18px;
  }

  /* Counter Box */
  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__counter-box {
    width: 100%;
    max-width: 520px;
    background: #FFFFFF;
    border: 2px solid {{ section.settings.border_color | default: '#0A0A0A' }};
    box-shadow: 5px 5px 0px {{ section.settings.border_color | default: '#0A0A0A' }};
    padding: 1.5rem 1.6rem;
    box-sizing: border-box;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__counter-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.1rem;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__counter-title {
    font-family: var(--font-heading-family);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.text_color | default: '#0A0A0A' }};
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__counter-badge {
    background-color: {{ section.settings.accent_color | default: '#CBD64A' }};
    border: 1.5px solid {{ section.settings.border_color | default: '#0A0A0A' }};
    padding: 0.3rem 0.75rem;
    font-family: var(--font-heading-family);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #0A0A0A;
  }

  /* Progress Bar Pill Track */
  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__track {
    width: 100%;
    height: 18px;
    background: #FFFFFF;
    border: 2px solid {{ section.settings.border_color | default: '#0A0A0A' }};
    position: relative;
    overflow: hidden;
    margin-bottom: 1.1rem;
    box-sizing: border-box;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__fill {
    height: 100%;
    background-color: {{ section.settings.accent_color | default: '#CBD64A' }};
    border-right: 2px solid {{ section.settings.border_color | default: '#0A0A0A' }};
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__counter-footer {
    font-family: var(--font-body-family);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: {{ section.settings.muted_text_color | default: '#555555' }};
    line-height: 1.5;
  }

  /* Right Column (Stacked Cards) */
  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__right {
    flex: 0 0 46%;
    max-width: 46%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__card {
    background: #FFFFFF;
    border: 2px solid {{ section.settings.border_color | default: '#0A0A0A' }};
    box-shadow: 5px 5px 0px {{ section.settings.border_color | default: '#0A0A0A' }};
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: default;
  }

  /* Hover State: ONLY the back shadow / shade changes to Brand Accent Color */
  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0px {{ section.settings.accent_color | default: '#CBD64A' }};
  }

  /* Icon Box - Borderless, Clean & Fixed Size */
  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__icon-box {
    width: {{ section.settings.icon_size | default: 38 }}px;
    height: {{ section.settings.icon_size | default: 38 }}px;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: {{ section.settings.text_color | default: '#0A0A0A' }};
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__custom-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__icon-box svg {
    width: 100%;
    height: 100%;
    stroke-width: 1.8;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__card-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__card-title {
    font-family: var(--font-heading-family);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.text_color | default: '#0A0A0A' }};
    margin: 0;
    line-height: 1.2;
  }

  .kore-founding-1000--{{ section.id }} .kore-founding-brutal__card-subtitle {
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    font-weight: 400;
    color: {{ section.settings.muted_text_color | default: '#555555' }};
    margin: 0;
    line-height: 1.4;
  }

  /* Mobile Responsiveness */
  @media screen and (max-width: 989px) {
    .kore-founding-1000--{{ section.id }} .kore-founding-brutal__grid {
      flex-direction: column;
      gap: 3rem;
    }

    .kore-founding-1000--{{ section.id }} .kore-founding-brutal__left,
    .kore-founding-1000--{{ section.id }} .kore-founding-brutal__right {
      flex: 0 0 100%;
      max-width: 100%;
      width: 100%;
    }

    .kore-founding-1000--{{ section.id }} .kore-founding-brutal__left {
      align-items: center;
      text-align: center;
    }

    .kore-founding-1000--{{ section.id }} .kore-founding-brutal__heading {
      text-align: center;
      width: 100%;
    }

    .kore-founding-1000--{{ section.id }} .kore-founding-brutal__desc-wrap {
      border-left: none;
      border-top: 3px solid {{ section.settings.accent_color | default: '#CBD64A' }};
      padding-left: 0;
      padding-top: 1rem;
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    .kore-founding-1000--{{ section.id }} .kore-founding-brutal__desc {
      text-align: center;
    }

    .kore-founding-1000--{{ section.id }} .kore-founding-brutal__btn {
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 2.25rem;
    }

    .kore-founding-1000--{{ section.id }} .kore-founding-brutal__counter-box {
      max-width: 100%;
      text-align: left;
    }
  }
{%- endstyle -%}

{%- liquid
  assign claimed_val = section.settings.claimed_count | default: 247
  assign total_val = section.settings.total_count | default: 1000

  if section.settings.progress_mode == 'manual'
    assign fill_percentage = section.settings.manual_progress_percent | default: 25
  else
    if total_val > 0
      assign fill_percentage = claimed_val | times: 100.0 | divided_by: total_val
    else
      assign fill_percentage = 0
    endif
  endif

  if fill_percentage > 100.0
    assign fill_percentage = 100.0
  endif
-%}

<div class="kore-founding-1000 kore-founding-1000--{{ section.id }}">
  <div class="page-width">
    <div class="kore-founding-brutal__grid">
      <!-- Left Column -->
      <div class="kore-founding-brutal__left">
        {%- if section.settings.heading != blank -%}
          <h2 class="kore-founding-brutal__heading">{{ section.settings.heading | newline_to_br }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="kore-founding-brutal__desc-wrap">
            <p class="kore-founding-brutal__desc">{{ section.settings.description | newline_to_br }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '/account/register' }}" class="kore-founding-brutal__btn">
            <span>{{ section.settings.button_label }}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {%- endif -%}

        <!-- Counter Box -->
        <div class="kore-founding-brutal__counter-box">
          <div class="kore-founding-brutal__counter-top">
            <span class="kore-founding-brutal__counter-title">{{ section.settings.counter_label | default: 'FOUNDING MEMBERS' }}</span>
            <span class="kore-founding-brutal__counter-badge">
              {{ section.settings.claimed_count | default: 247 }} / {{ section.settings.total_count | default: 1000 }} CLAIMED
            </span>
          </div>

          <div class="kore-founding-brutal__track">
            <div class="kore-founding-brutal__fill" style="width: {{ fill_percentage }}%;"></div>
          </div>

          {%- if section.settings.counter_footer_text != blank -%}
            <div class="kore-founding-brutal__counter-footer">
              {{ section.settings.counter_footer_text | newline_to_br }}
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Right Column (Stacked Cards) -->
      <div class="kore-founding-brutal__right">
        {%- for block in section.blocks -%}
          <div class="kore-founding-brutal__card" {{ block.shopify_attributes }}>
            <div class="kore-founding-brutal__icon-box">
              {%- if block.settings.custom_icon != blank -%}
                {{ block.settings.custom_icon | image_url: width: 120 | image_tag:
                  loading: 'lazy',
                  class: 'kore-founding-brutal__custom-img',
                  widths: '36, 48, 72, 96, 120',
                  alt: block.settings.title
                }}
              {%- elsif block.settings.custom_svg != blank -%}
                {{ block.settings.custom_svg }}
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'crown' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  {%- when 'star_badge' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polygon points="12 6 13.8 9.6 17.8 10.2 14.9 13 15.6 17 12 15.1 8.4 17 9.1 13 6.2 10.2 10.2 9.6 12 6"></polygon>
                    </svg>
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 12 20 22 4 22 4 12"></polyline>
                      <rect x="2" y="7" width="20" height="5"></rect>
                      <line x1="12" y1="22" x2="12" y2="7"></line>
                      <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                      <path d="M12 7h4.5a2.5 2.5 0 0 1 0-5C13 2 12 7 12 7z"></path>
                    </svg>
                  {%- when 'ticket' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 9a3 3 0 0 1 0 6v5a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a3 3 0 0 1 0-6V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v5z"></path>
                      <line x1="9" y1="12" x2="15" y2="12"></line>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 8 12 12 14 14"></polyline>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </div>

            <div class="kore-founding-brutal__card-content">
              <h3 class="kore-founding-brutal__card-title">{{ block.settings.title }}</h3>
              {%- if block.settings.subtitle != blank -%}
                <p class="kore-founding-brutal__card-subtitle">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KØRĒ Founding 1000 VIP",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Theme Colors & Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#F8F8F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main Heading & Text Color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted / Subtitle Text Color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Solid Border & Drop Shadow Color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Brand Accent (Shadow Hover & Fill)",
      "default": "#CBD64A"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Icon Display Size",
      "default": 36
    },
    {
      "type": "header",
      "content": "Left Column Headline & Button"
    },
    {
      "type": "textarea",
      "id": "heading",
      "default": "THE FIRST 1000\nWILL NEVER\nHAPPEN AGAIN.",
      "label": "Main Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "default": "Become one of the first 1,000 members of KOURTLAB and unlock benefits that will never be offered again.",
      "label": "Description Paragraph"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 18
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "JOIN THE FOUNDING 1000",
      "label": "CTA Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "CTA Button Link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background Color",
      "default": "#CBD64A"
    },
    {
      "type": "header",
      "content": "Claimed Members Progress Bar Control"
    },
    {
      "type": "select",
      "id": "progress_mode",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (Calculated from Claimed vs Total Count)"
        },
        {
          "value": "manual",
          "label": "Manual Percentage Slider (0% to 100%)"
        }
      ],
      "default": "auto",
      "label": "Progress Fill Control Mode"
    },
    {
      "type": "range",
      "id": "manual_progress_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Manual Progress Fill Percentage (0% - 100%)",
      "default": 25
    },
    {
      "type": "text",
      "id": "counter_label",
      "default": "FOUNDING MEMBERS",
      "label": "Counter Header Label"
    },
    {
      "type": "number",
      "id": "claimed_count",
      "default": 247,
      "label": "Claimed Members Count"
    },
    {
      "type": "number",
      "id": "total_count",
      "default": 1000,
      "label": "Total Members Limit"
    },
    {
      "type": "textarea",
