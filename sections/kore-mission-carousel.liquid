      "settings": [
        {
          "type": "select",
          "id": "card_style",
          "options": [
            { "value": "photo", "label": "Photo Overlay Card" },
            { "value": "dark", "label": "Solid Dark Card" }
          ],
          "default": "photo",
          "label": "Card Style"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Inspired by athletes."
        },
        {
          "type": "text",
          "id": "description",
          "label": "Card Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card background color",
          "default": "#0a0a0a"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KØRĒ Mission Carousel",
      "blocks": [
        {
          "type": "story_card",
          "settings": {
            "card_style": "photo",
            "title": "Inspired by athletes."
          }
        },
        {
          "type": "story_card",
          "settings": {
            "card_style": "dark",
            "title": "Powered by Swiss engineering."
          }
        },
        {
          "type": "story_card",
          "settings": {
            "card_style": "photo",
            "title": "We believe amazing things happen when we move."
          }
        },
        {
          "type": "story_card",
          "settings": {
            "card_style": "dark",
            "title": "Whether that's breaking records on the track..."
          }
        },
        {
          "type": "story_card",
          "settings": {
            "card_style": "photo",
