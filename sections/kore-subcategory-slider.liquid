{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #KoreSubcatSlider-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    color: {{ section.settings.text_color | default: '#0a0a0a' }};
  }

  #KoreSubcatSlider-{{ section.id }} .kore-subcat-section__heading {
    color: {{ section.settings.text_color | default: '#0a0a0a' }};
  }
{%- endstyle -%}

<div class="kore-subcat-section section-{{ section.id }}-padding" id="KoreSubcatSlider-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="kore-subcat-section__header kore-subcat-section__header--{{ section.settings.header_alignment | default: 'left' }}">
        <h2 class="kore-subcat-section__heading inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    {%- liquid
      assign selected_collection = section.settings.collection
      assign products_limit = section.settings.products_to_show | default: 20
      assign cols_desktop = section.settings.columns_desktop | default: 4
      assign card_ratio = section.settings.aspect_ratio | default: 'portrait'
    -%}

    <div class="kore-subcat-slider" data-cols-desktop="{{ cols_desktop }}">
      <div class="kore-subcat-slider__track-wrap" id="KoreSubcatTrackWrap-{{ section.id }}">
        <div class="kore-subcat-slider__track">
          {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
            {%- for product in selected_collection.products limit: products_limit -%}
              {%- liquid
                assign display_title = ""
                if section.settings.title_source == 'metafield' and section.settings.metafield_key != blank
                  assign mf_parts = section.settings.metafield_key | split: '.'
                  if mf_parts.size == 2
                    assign mf_ns = mf_parts[0]
                    assign mf_k = mf_parts[1]
                    assign display_title = product.metafields[mf_ns][mf_k].value | default: product.metafields[mf_ns][mf_k]
                  endif
                elsif section.settings.title_source == 'vendor'
                  assign display_title = product.vendor
                elsif section.settings.title_source == 'type'
                  assign display_title = product.type
                elsif section.settings.title_source == 'full'
                  assign display_title = product.title
                endif

                if display_title == blank
                  assign words_limit = section.settings.max_words | default: 2
                  assign display_title = product.title | truncatewords: words_limit, ""
                endif
              -%}
              <div class="kore-subcat-card">
                <a href="{{ product.url }}" class="kore-subcat-card__link">
                  <div class="kore-subcat-card__img-box kore-subcat-card__img-box--{{ card_ratio }}">
                    {%- if product.featured_media != blank -%}
                      {{ product.featured_media | image_url: width: 750 | image_tag:
                        loading: 'lazy',
                        class: 'kore-subcat-card__img',
                        widths: '360, 540, 750',
                        alt: product.title
                      }}
                    {%- else -%}
                      <div class="kore-subcat-card__placeholder">
                        {%- assign p_idx = forloop.index | modulo: 6 | plus: 1 -%}
                        {{ 'product-' | append: p_idx | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="kore-subcat-card__info">
                    <span class="kore-subcat-card__title">{{ display_title }}</span>
                    {%- if section.settings.show_price -%}
                      <span class="kore-subcat-card__price">{{ product.price | money }}</span>
                    {%- endif -%}
                  </div>
                </a>
              </div>
            {%- endfor -%}
          {%- elsif section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign block_coll = block.settings.collection
                assign card_title = block.settings.title
                if card_title == blank and block_coll != blank
                  assign card_title = block_coll.title
                endif
                if card_title == blank
                  assign card_title = "Collection Title"
                endif

                assign card_image = block.settings.image
                if card_image == blank and block_coll != blank
                  assign card_image = block_coll.featured_image
                endif

                assign card_url = block.settings.link
                if card_url == blank and block_coll != blank
                  assign card_url = block_coll.url
                endif
                if card_url == blank
                  assign card_url = "#"
                endif
              -%}
              <div class="kore-subcat-card" {{ block.shopify_attributes }}>
                <a href="{{ card_url }}" class="kore-subcat-card__link">
                  <div class="kore-subcat-card__img-box kore-subcat-card__img-box--{{ card_ratio }}">
                    {%- if card_image != blank -%}
                      {{ card_image | image_url: width: 750 | image_tag:
                        loading: 'lazy',
                        class: 'kore-subcat-card__img',
                        widths: '360, 540, 750',
                        alt: card_title
                      }}
                    {%- else -%}
                      <div class="kore-subcat-card__placeholder">
                        {%- assign p_idx = forloop.index | modulo: 6 | plus: 1 -%}
                        {{ 'product-' | append: p_idx | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="kore-subcat-card__info">
                    <span class="kore-subcat-card__title">{{ card_title }}</span>
                  </div>
                </a>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..8) -%}
              <div class="kore-subcat-card">
                <div class="kore-subcat-card__img-box kore-subcat-card__img-box--{{ card_ratio }}">
                  <div class="kore-subcat-card__placeholder">
                    {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                </div>
                <div class="kore-subcat-card__info">
                  <span class="kore-subcat-card__title">Sample Item {{ i }}</span>
                  {%- if section.settings.show_price -%}
                    <span class="kore-subcat-card__price">$120.00</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <!-- Slider Controls & Progress Bar -->
      <div class="kore-subcat-slider__controls">
        <div class="kore-subcat-slider__nav-btns">
          <button type="button" class="kore-subcat-slider__btn kore-subcat-slider__btn--prev" aria-label="Previous slide">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>
          <button type="button" class="kore-subcat-slider__btn kore-subcat-slider__btn--next" aria-label="Next slide">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>

        <div class="kore-subcat-slider__progress">
          <div class="kore-subcat-slider__progress-bar"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .kore-subcat-section {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .kore-subcat-section__header {
    margin-bottom: 2rem;
  }

  .kore-subcat-section__header--left {
    text-align: left;
  }

  .kore-subcat-section__header--center {
    text-align: center;
  }

  .kore-subcat-section__heading {
    margin: 0;
    font-family: var(--font-heading-family), 'Barlow Condensed', 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  /* Slider Container */
  .kore-subcat-slider {
    position: relative;
    width: 100%;
  }

  .kore-subcat-slider__track-wrap {
    width: 100%;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 0.5rem;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    container-type: inline-size;
  }

  .kore-subcat-slider__track-wrap.is-dragging {
    cursor: grabbing !important;
    scroll-behavior: auto !important;
    scroll-snap-type: none !important;
  }

  .kore-subcat-slider__track-wrap::-webkit-scrollbar {
    display: none;
  }

  .kore-subcat-slider__track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
  }

  /* Cards - 4 Columns Desktop by Default */
  .kore-subcat-card {
    flex: 0 0 calc((100cqw - (3 * 1.5rem)) / 4);
    width: calc((100cqw - (3 * 1.5rem)) / 4);
    min-width: 0;
    max-width: none;
    scroll-snap-align: start;
    box-sizing: border-box;
  }

  @media screen and (max-width: 1024px) {
    .kore-subcat-slider__track {
      gap: 1.25rem;
    }
    .kore-subcat-card {
      flex: 0 0 calc((100cqw - (2 * 1.25rem)) / 3);
      width: calc((100cqw - (2 * 1.25rem)) / 3);
    }
  }

  @media screen and (max-width: 749px) {
    .kore-subcat-slider__track {
      gap: 1rem;
    }
    .kore-subcat-card {
      flex: 0 0 72vw;
      width: 72vw;
      max-width: 290px;
    }
  }

  .kore-subcat-card__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .kore-subcat-card__img-box {
    background-color: #f4f4f4;
    border-radius: 0;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kore-subcat-card__img-box--portrait {
    aspect-ratio: 3 / 4;
  }

  .kore-subcat-card__img-box--editorial {
    aspect-ratio: 4 / 5;
  }

  .kore-subcat-card__img-box--square {
    aspect-ratio: 1 / 1;
  }

  .kore-subcat-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }

  .kore-subcat-card:hover .kore-subcat-card__img {
    transform: scale(1.045);
  }

  .kore-subcat-card__placeholder {
    width: 100%;
    height: 100%;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eaeaea;
  }

  .kore-subcat-card__placeholder svg {
    width: 70%;
    height: 70%;
    opacity: 0.45;
  }

  .kore-subcat-card__info {
    padding: 1.1rem 0.1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .kore-subcat-card__title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: inherit;
    display: block;
    line-height: 1.25;
    font-family: var(--font-body-family), 'Inter', sans-serif;
  }

  .kore-subcat-card__price {
    font-size: 1.15rem;
    font-weight: 500;
    opacity: 0.75;
    font-family: var(--font-body-family), 'Inter', sans-serif;
  }

  /* Slider Controls */
  .kore-subcat-slider__controls {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 2.5rem;
    padding: 0 0.2rem;
  }

  .kore-subcat-slider__nav-btns {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .kore-subcat-slider__btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .kore-subcat-slider__btn:hover {
    opacity: 0.5;
    transform: scale(1.1);
  }

  .kore-subcat-slider__progress {
    height: 2px;
    width: 180px;
    background: #e5e5e5;
    position: relative;
    overflow: hidden;
  }

  .kore-subcat-slider__progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 25%;
    background: #0a0a0a;
    transition: left 0.15s ease, width 0.15s ease;
  }
</style>

<script>
  (function() {
    function initSubcatSlider(section) {
      if (!section) return;

      const sliderEl = section.querySelector('.kore-subcat-slider');
      const trackWrap = section.querySelector('.kore-subcat-slider__track-wrap');
      const track = section.querySelector('.kore-subcat-slider__track');
      const prevBtn = section.querySelector('.kore-subcat-slider__btn--prev');
      const nextBtn = section.querySelector('.kore-subcat-slider__btn--next');
      const progressBar = section.querySelector('.kore-subcat-slider__progress-bar');

      if (!trackWrap || !track) return;

      const colsDesktop = parseInt(sliderEl?.dataset?.colsDesktop || '4', 10);

      function calculateLayout() {
        const wrapWidth = trackWrap.clientWidth;
        if (wrapWidth <= 0) return;

        let cols = colsDesktop;
        let gap = 24;

        if (window.innerWidth <= 749) {
          cols = 1.38;
          gap = 16;
        } else if (window.innerWidth <= 1024) {
          cols = Math.min(colsDesktop, 3);
          gap = 20;
        }

        const cardWidth = Math.floor((wrapWidth - (Math.floor(cols) - 1) * gap) / cols);

        if (cardWidth > 120) {
          track.style.gap = `${gap}px`;
          const cards = track.querySelectorAll('.kore-subcat-card');
          cards.forEach(card => {
            card.style.flex = `0 0 ${cardWidth}px`;
            card.style.width = `${cardWidth}px`;
          });
        }
      }

      function updateProgress() {
        if (!progressBar) return;
        const maxScroll = trackWrap.scrollWidth - trackWrap.clientWidth;
        if (maxScroll <= 0) {
          progressBar.style.width = '100%';
          progressBar.style.left = '0%';
          return;
        }
        const scrollRatio = trackWrap.scrollLeft / maxScroll;
        const visibleRatio = trackWrap.clientWidth / trackWrap.scrollWidth;
        const barWidthPercent = Math.max(visibleRatio * 100, 20);
        progressBar.style.width = `${barWidthPercent}%`;
        progressBar.style.left = `${scrollRatio * (100 - barWidthPercent)}%`;
      }

      calculateLayout();
      updateProgress();

      window.addEventListener('resize', () => {
        calculateLayout();
        updateProgress();
      });

      trackWrap.addEventListener('scroll', updateProgress, { passive: true });

      function getScrollStep() {
        const firstCard = track.querySelector('.kore-subcat-card');
        if (firstCard) {
          return firstCard.offsetWidth + 24;
        }
        return 320;
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          trackWrap.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          trackWrap.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
        });
      }

      // Mouse Drag to Slide
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;
      let hasDragged = false;

      trackWrap.addEventListener('mousedown', function(e) {
        isDown = true;
        hasDragged = false;
        trackWrap.classList.add('is-dragging');
        startX = e.pageX - trackWrap.offsetLeft;
        scrollLeft = trackWrap.scrollLeft;
      });

      window.addEventListener('mouseup', function() {
        if (!isDown) return;
        isDown = false;
        trackWrap.classList.remove('is-dragging');
      });

      trackWrap.addEventListener('mouseleave', function() {
        if (!isDown) return;
        isDown = false;
        trackWrap.classList.remove('is-dragging');
      });

      trackWrap.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - trackWrap.offsetLeft;
        const walk = (x - startX) * 1.3;
        if (Math.abs(walk) > 6) {
          hasDragged = true;
        }
        trackWrap.scrollLeft = scrollLeft - walk;
      });

      trackWrap.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', function(e) {
          if (hasDragged) {
            e.preventDefault();
            e.stopImmediatePropagation();
          }
        });
      });
    }

    function setup() {
      const section = document.getElementById('KoreSubcatSlider-{{ section.id }}');
      if (section) initSubcatSlider(section);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        setup();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "KØRĒ Subcategory Slider",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Best Sellers"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left",
      "label": "Header alignment"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select a Shopify collection to automatically display its products"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns visible on desktop"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Product Image Aspect Ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "editorial", "label": "Editorial (4:5)" },
        { "value": "square", "label": "Square (1:1)" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 40,
      "step": 1,
      "default": 16,
      "label": "Maximum products to show"
    },
    {
      "type": "select",
      "id": "title_source",
      "label": "Card title source",
      "options": [
        { "value": "short_title", "label": "Short Title (e.g., 2 words max)" },
        { "value": "metafield", "label": "Product Metafield (custom short name)" },
        { "value": "vendor", "label": "Product Vendor / Brand" },
        { "value": "type", "label": "Product Type" },
        { "value": "full", "label": "Full Product Title" }
      ],
      "default": "short_title"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Product Metafield Key (if Metafield selected)",
      "default": "custom.short_name"
    },
    {
      "type": "range",
      "id": "max_words",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2,
      "label": "Maximum title words (if Short Title selected)"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": true,
      "label": "Show product prices"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Custom Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Card Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Card Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KØRĒ Subcategory Slider"
    }
  ]
}
{% endschema %}
