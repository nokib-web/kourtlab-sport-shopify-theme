{{ 'section-our-story.css' | asset_url | stylesheet_tag }}

<section id="manifesto" class="our-story-manifesto color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="our-story-manifesto__inner{% if section.settings.image_position == 'right' %} our-story-manifesto__inner--reverse{% endif %}">
      <!-- Media Column -->
      <div class="our-story-manifesto__col our-story-manifesto__col--media">
        <div class="our-story-manifesto__img-wrap">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              alt="{{ section.settings.heading | escape }}"
              loading="lazy"
              class="our-story-manifesto__img"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'our-story-manifesto__img placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if section.settings.floating_card_num != blank or section.settings.floating_card_text != blank -%}
          <div class="our-story-manifesto__floating-card">
            {%- if section.settings.floating_card_num != blank -%}
              <div class="our-story-manifesto__card-num">{{ section.settings.floating_card_num }}</div>
            {%- endif -%}
            {%- if section.settings.floating_card_text != blank -%}
              <p class="our-story-manifesto__card-text">{{ section.settings.floating_card_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Text Column -->
      <div class="our-story-manifesto__col our-story-manifesto__col--text">
        {%- if section.settings.label != blank -%}
          <span class="our-story-manifesto__label">{{ section.settings.label }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="our-story-manifesto__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.quote != blank -%}
          <blockquote class="our-story-manifesto__quote">{{ section.settings.quote }}</blockquote>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="our-story-manifesto__body">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="our-story-manifesto__stats">
            {%- for block in section.blocks -%}
              <div class="our-story-stat" {{ block.shopify_attributes }}>
                <div class="our-story-stat__val">{{ block.settings.stat_value }}</div>
                <div class="our-story-stat__lbl">{{ block.settings.stat_label }}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story Manifesto Split",
  "class": "section-our-story-manifesto",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "floating_card_num",
      "label": "Floating Card Number / Metric",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "floating_card_text",
      "label": "Floating Card Description",
      "default": "TECHNICAL ATHLETIC PERFORMANCE"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Sub-label",
      "default": "THE KØRE MANIFESTO"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "DESIGNED FOR THE COURT. <span>CRAFTED FOR THE CITY.</span>"
    },
    {
      "type": "inline_richtext",
      "id": "quote",
      "label": "Featured Mission Quote",
      "default": "We don't create gear for spectators. We engineer apparel for athletes who live every point, every game, every single day."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Paragraphs",
      "default": "<p>Padel is more than a sport — it's a high-energy culture that demands speed, style, and relentless focus. KØRE was created to bridge the gap between technical court performance and refined urban streetwear.</p><p>Every garment is tested in intense match conditions using light, breathable, multi-stretch fabrics built to withstand every drop shot and smash.</p>"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Metric Stat Block",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "stat_value",
          "label": "Stat Value / Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Stat Label",
          "default": "PADEL FIRST APPAREL BRAND"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story Manifesto Split",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "stat_value": "100%",
            "stat_label": "TECHNICAL APPAREL"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat_value": "24/7",
            "stat_label": "ATHLETIC MINDSET"
          }
        }
      ]
    }
  ]
}
{% endschema %}
