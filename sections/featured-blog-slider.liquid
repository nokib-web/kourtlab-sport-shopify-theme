{{ 'section-featured-blog-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #FeaturedBlogSlider-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
    {% endif %}
  }

  #FeaturedBlogSlider-{{ section.id }} .blog-slider__heading {
    color: {{ section.settings.heading_color }};
  }

  #FeaturedBlogSlider-{{ section.id }} .blog-slider__heading em {
    color: {{ section.settings.accent_color }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient" id="FeaturedBlogSlider-{{ section.id }}">
  <div class="blog-slider-wrapper page-width section-{{ section.id }}-padding">
    <div class="blog-slider__header">
      <div class="blog-slider__header-left">
        {%- if section.settings.title != blank -%}
          <h2 class="blog-slider__heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
      </div>
      
      <div class="blog-slider__header-right">
        {%- if section.settings.show_view_all and section.settings.blog != blank -%}
          <a href="{{ section.settings.blog.url }}" class="button{% if section.settings.view_all_style_secondary %} button--secondary{% endif %} blog-slider__view-all">
            {{ section.settings.view_all_text }}
          </a>
        {%- endif -%}

        <div class="blog-slider__controls">
          <button
            type="button"
            class="blog-slider__btn blog-slider__btn--prev"
            id="BlogPrev-{{ section.id }}"
            aria-label="Previous posts"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.2" fill="none">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="blog-slider__btn blog-slider__btn--next"
            id="BlogNext-{{ section.id }}"
            aria-label="Next posts"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.2" fill="none">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="blog-slider-container" id="BlogSliderContainer-{{ section.id }}">
      <div class="blog-slider" id="BlogSlider-{{ section.id }}">
        {%- assign blog = section.settings.blog -%}
        {%- if blog != blank and blog.articles_count > 0 -%}
          {%- for article in blog.articles limit: section.settings.post_limit -%}
            <div class="blog-slider__card">
              <a href="{{ article.url }}" class="blog-slider__card-link">
                <div class="blog-slider__media">
                  {%- if article.image != blank -%}
                    <img
                      src="{{ article.image | image_url: width: 800 }}"
                      alt="{{ article.image.alt | escape }}"
                      loading="lazy"
                      class="blog-slider__img"
                      width="{{ article.image.width }}"
                      height="{{ article.image.height }}"
                    >
                  {%- else -%}
                    <div class="blog-slider__placeholder">
                      {%- assign placeholder_index = forloop.index | modulo: 3 | plus: 1 -%}
                      {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                  <div class="blog-slider__overlay"></div>
                  <div class="blog-slider__card-content">
                    <h3 class="blog-slider__card-title">{{ article.title }}</h3>
                  </div>
                </div>
              </a>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="blog-slider__card">
              <div class="blog-slider__card-link">
                <div class="blog-slider__media">
                  <div class="blog-slider__placeholder">
                    {%- assign placeholder_index = i | modulo: 3 | plus: 1 -%}
                    {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                  <div class="blog-slider__overlay"></div>
                  <div class="blog-slider__card-content">
                    <h3 class="blog-slider__card-title">
                      {%- case i -%}
                        {%- when 1 -%}On's shoe finder
                        {%- when 2 -%}Tenniscore styling
                        {%- when 3 -%}Lane 1: The running mindset
                        {%- when 4 -%}Discover our athletes
                      {%- endcase -%}
                    </h3>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('BlogSlider-{{ section.id }}');
    const prevBtn = document.getElementById('BlogPrev-{{ section.id }}');
    const nextBtn = document.getElementById('BlogNext-{{ section.id }}');

    if (track && prevBtn && nextBtn) {
      function getScrollDistance() {
        const firstCard = track.querySelector('.blog-slider__card');
        return firstCard ? (firstCard.offsetWidth + 20) * 1.5 : 450;
      }

      prevBtn.addEventListener('click', function() {
        track.scrollBy({ left: -getScrollDistance(), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', function() {
        track.scrollBy({ left: getScrollDistance(), behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Featured Blog Slider",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "default": "transparent",
      "label": "Section Background Color"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Section Background Image"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Stories that <em>move</em>",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "default": "#111111",
      "label": "Heading Main Text Color"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#CBD64A",
      "label": "Heading Accent Color"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'View all' button"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "default": "Read all blog",
      "label": "View all button text"
    },
    {
      "type": "checkbox",
      "id": "view_all_style_secondary",
      "default": true,
      "label": "Use outline button style"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Maximum blog posts to show"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Featured Blog Slider"
    }
  ]
}
{% endschema %}
