{{ 'section-featured-blog-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .blog-slider-section--{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: 'transparent' }};
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    --blog-card-title-size: {{ section.settings.card_title_font_size | default: 21 }}px;
    --blog-card-excerpt-size: {{ section.settings.card_excerpt_font_size | default: 17 }}px;
  }
{%- endstyle -%}

<div class="blog-slider-section blog-slider-section--{{ section.id }}" id="FeaturedBlogSlider-{{ section.id }}">
  <div class="blog-slider__container">
    <div class="blog-slider__header">
      <div class="blog-slider__header-left">
        {%- if section.settings.tagline != blank -%}
          <div class="blog-slider__tagline" style="color: {{ section.settings.tagline_color | default: '#A6B828' }} !important;">
            {{ section.settings.tagline }}
          </div>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="blog-slider__heading" style="color: {{ section.settings.heading_color | default: '#0A0A0A' }} !important;">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
      </div>

      <div class="blog-slider__header-right">
        {%- if section.settings.show_view_all -%}
          <a href="{{ section.settings.blog.url | default: '/blogs/nieuws' }}" class="blog-slider__view-all">
            <span>{{ section.settings.view_all_text | default: 'VIEW ALL STORIES' }}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {%- endif -%}

        <div class="blog-slider__controls">
          <button type="button" class="blog-slider__btn" id="BlogPrev-{{ section.id }}" onclick="const t=document.getElementById('BlogSlider-{{ section.id }}'); if(t){ const c=t.querySelector('.blog-slider__card'); t.scrollBy({left: -(c ? c.offsetWidth + 20 : 350), behavior: 'smooth'}); }" aria-label="Previous">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button type="button" class="blog-slider__btn" id="BlogNext-{{ section.id }}" onclick="const t=document.getElementById('BlogSlider-{{ section.id }}'); if(t){ const c=t.querySelector('.blog-slider__card'); t.scrollBy({left: (c ? c.offsetWidth + 20 : 350), behavior: 'smooth'}); }" aria-label="Next">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="blog-slider__track-wrapper">
      <div class="blog-slider__track" id="BlogSlider-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '/blogs/nieuws' }}" class="blog-slider__card" {{ block.shopify_attributes }}>
              <div class="blog-slider__card-media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'blog-slider__card-img' }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg blog-slider__card-img' }}
                {%- endif -%}
                <div class="blog-slider__card-overlay">
                  <h3 class="blog-slider__card-title">{{ block.settings.title }}</h3>
                </div>
              </div>
            </a>
          {%- endfor -%}
        {%- elsif section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
          {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
            <a href="{{ article.url }}" class="blog-slider__card">
              <div class="blog-slider__card-media">
                {%- if article.image != blank -%}
                  {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'blog-slider__card-img' }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg blog-slider__card-img' }}
                {%- endif -%}
                <div class="blog-slider__card-overlay">
                  <h3 class="blog-slider__card-title">{{ article.title }}</h3>
                </div>
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Default 5 Reference Cards matching Mockup {%- endcomment -%}
          {%- for i in (1..5) -%}
            <a href="/blogs/nieuws" class="blog-slider__card">
              <div class="blog-slider__card-media">
                {%- case i -%}
                  {%- when 1 -%}{%- assign title = 'FROM COURT TO COAST' -%}
                  {%- when 2 -%}{%- assign title = 'BEHIND THE FIRST DROP' -%}
                  {%- when 3 -%}{%- assign title = 'WHY WE BUILT KOURTLAB' -%}
                  {%- when 4 -%}{%- assign title = 'PERFORMANCE GUIDE' -%}
                  {%- when 5 -%}{%- assign title = 'MEET THE FOUNDER' -%}
                {%- endcase -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg blog-slider__card-img' }}
                <div class="blog-slider__card-overlay">
                  <h3 class="blog-slider__card-title">{{ title }}</h3>
                </div>
              </div>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('BlogSlider-{{ section.id }}');
    const prevBtn = document.getElementById('BlogPrev-{{ section.id }}');
    const nextBtn = document.getElementById('BlogNext-{{ section.id }}');

    if (track && prevBtn && nextBtn) {
      function getScrollDistance() {
        const firstCard = track.querySelector('.blog-slider__card');
        return firstCard ? (firstCard.offsetWidth + 20) * 1.5 : 350;
      }

      prevBtn.addEventListener('click', function() {
        track.scrollBy({ left: -getScrollDistance(), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', function() {
        track.scrollBy({ left: getScrollDistance(), behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Featured Blog Slider",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "default": "transparent",
      "label": "Section Background Color"
    },
    {
      "type": "text",
      "id": "tagline",
      "default": "THE FOUNDING 1000",
      "label": "Eyebrow Tagline"
    },
    {
      "type": "color",
      "id": "tagline_color",
      "default": "#A6B828",
      "label": "Eyebrow Color"
    },
    {
      "type": "text",
      "id": "title",
      "default": "STORIES THAT MOVE.",
      "label": "Heading Title"
    },
    {
      "type": "color",
      "id": "heading_color",
      "default": "#0A0A0A",
      "label": "Heading Text Color"
    },
    {
      "type": "header",
      "content": "Card Font Size Controls"
    },
    {
      "type": "range",
      "id": "card_title_font_size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Card Title Font Size",
      "default": 21
    },
    {
      "type": "range",
      "id": "card_excerpt_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card Excerpt Font Size",
      "default": 17
    },
    {
      "type": "header",
      "content": "Blog & Controls"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Shopify Blog Source"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'VIEW ALL STORIES' Link"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "default": "VIEW ALL STORIES",
      "label": "View All Button Text"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "label": "Maximum Blog Posts to Show"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Custom Story Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Story Image"
        },
        {
          "type": "text",
          "id": "title",
          "default": "FROM COURT TO COAST",
          "label": "Story Title"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "default": "Our roots. Our inspiration.",
          "label": "Story Excerpt"
        },
        {
          "type": "text",
          "id": "read_more_text",
          "default": "READ MORE",
          "label": "Read More Button Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Story Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Blog Slider",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "title": "FROM COURT TO COAST",
            "excerpt": "Our roots. Our inspiration."
          }
        },
        {
          "type": "story",
          "settings": {
            "title": "BEHIND THE FIRST DROP",
            "excerpt": "The process, the materials, the details."
          }
        },
        {
          "type": "story",
          "settings": {
            "title": "WHY WE BUILT KOURTLAB",
            "excerpt": "More than apparel. A mindset."
          }
        },
        {
          "type": "story",
          "settings": {
            "title": "PERFORMANCE GUIDE",
            "excerpt": "What to wear, when and why."
          }
        },
        {
          "type": "story",
          "settings": {
            "title": "MEET THE FOUNDER",
            "excerpt": "Justin Niessen on passion and purpose."
          }
        }
      ]
    }
  ]
}
{% endschema %}
