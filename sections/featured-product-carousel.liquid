{{ 'section-featured-product-carousel.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #FeaturedProductCarousel-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
    {% endif %}
  }

  #FeaturedProductCarousel-{{ section.id }} .product-carousel__heading {
    color: {{ section.settings.heading_color }};
  }

  #FeaturedProductCarousel-{{ section.id }} .product-carousel__heading em {
    color: {{ section.settings.accent_color }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient" id="FeaturedProductCarousel-{{ section.id }}">
  <div class="featured-product-carousel-wrapper page-width section-{{ section.id }}-padding">
    <div class="product-carousel__header">
      {%- if section.settings.title != blank -%}
        <h2 class="product-carousel__heading inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}

      <!-- Header Arrow Controls -->
      <div class="product-carousel__controls">
        <button
          type="button"
          class="product-carousel__btn product-carousel__btn--prev"
          id="ProductPrev-{{ section.id }}"
          aria-label="Previous products"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.2" fill="none">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="product-carousel__btn product-carousel__btn--next"
          id="ProductNext-{{ section.id }}"
          aria-label="Next products"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.2" fill="none">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <div class="product-carousel-container" id="ProductCarouselContainer-{{ section.id }}">
      <div class="product-carousel" id="ProductCarousel-{{ section.id }}">
        {%- assign collection = section.settings.collection -%}
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            <div class="product-carousel__card">
              <button class="product-carousel__wishlist" aria-label="Add to wishlist">
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="1.8" fill="none">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>

              <a href="{{ product.url }}" class="product-carousel__media-link">
                <div class="product-carousel__media">
                  {%- if product.featured_media != blank -%}
                    <img
                      src="{{ product.featured_media | image_url: width: 700 }}"
                      alt="{{ product.featured_media.alt | escape }}"
                      loading="lazy"
                      class="product-carousel__img"
                      width="{{ product.featured_media.width }}"
                      height="{{ product.featured_media.height }}"
                    >
                  {%- else -%}
                    <div class="product-carousel__placeholder">
                      {%- assign placeholder_index = forloop.index | modulo: 4 | plus: 1 -%}
                      {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>
              </a>

              <div class="product-carousel__info">
                {%- if forloop.index == 1 -%}
                  <span class="product-carousel__badge product-carousel__badge--new">NEW</span>
                {%- elsif forloop.index == 2 or forloop.index == 3 -%}
                  <span class="product-carousel__badge product-carousel__badge--bestseller">BESTSELLER</span>
                {%- endif -%}

                <h3 class="product-carousel__title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>

                <p class="product-carousel__tagline">
                  {%- if product.metafields.descriptors.subtitle != blank -%}
                    {{ product.metafields.descriptors.subtitle }}
                  {%- else -%}
                    Performance apparel & essentials
                  {%- endif -%}
                </p>

                <div class="product-carousel__price">
                  {{ product.price | money }}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <div class="product-carousel__card">
              <button class="product-carousel__wishlist" aria-label="Add to wishlist">
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="1.8" fill="none">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>

              <div class="product-carousel__media-link">
                <div class="product-carousel__media">
                  <div class="product-carousel__placeholder">
                    {%- assign placeholder_index = forloop.index | modulo: 4 | plus: 1 -%}
                    {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                </div>
              </div>

              <div class="product-carousel__info">
                {%- if i == 1 -%}
                  <span class="product-carousel__badge product-carousel__badge--new">NEW</span>
                {%- elsif i == 2 or i == 3 -%}
                  <span class="product-carousel__badge product-carousel__badge--bestseller">BESTSELLER</span>
                {%- endif -%}

                <h3 class="product-carousel__title">
                  {%- case i -%}
                    {%- when 1 -%}Train Flex Tank
                    {%- when 2 -%}Club-T
                    {%- when 3 -%}Court-T
                    {%- when 4 -%}3" Performance Short
                    {%- when 5 -%}Pro Match Polo
                    {%- when 6 -%}Speed Crew Sock
                  {%- endcase -%}
                </h3>

                <p class="product-carousel__tagline">
                  {%- case i -%}
                    {%- when 1 -%}High-intensity training
                    {%- when 2 -%}Travel, recovery, all-day wear
                    {%- when 3 -%}Tennis & padel court
                    {%- when 4 -%}Lightweight breathable stretch
                    {%- when 5 -%}Engineered ventilation
                    {%- when 6 -%}Cushioned arch support
                  {%- endcase -%}
                </p>

                <div class="product-carousel__price">
                  {%- case i -%}
                    {%- when 1 -%}CHF 90.00
                    {%- when 2 -%}CHF 70.00
                    {%- when 3 -%}CHF 100.00
                    {%- when 4 -%}CHF 85.00
                    {%- when 5 -%}CHF 110.00
                    {%- when 6 -%}CHF 25.00
                  {%- endcase -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('ProductCarousel-{{ section.id }}');
    const prevBtn = document.getElementById('ProductPrev-{{ section.id }}');
    const nextBtn = document.getElementById('ProductNext-{{ section.id }}');

    if (track && prevBtn && nextBtn) {
      function getScrollDistance() {
        const firstCard = track.querySelector('.product-carousel__card');
        return firstCard ? (firstCard.offsetWidth + 20) * 1.5 : 450;
      }

      prevBtn.addEventListener('click', function() {
        track.scrollBy({ left: -getScrollDistance(), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', function() {
        track.scrollBy({ left: getScrollDistance(), behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Featured Product Slider",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "default": "transparent",
      "label": "Section Background Color"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Section Background Image"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "For playing <em>on hot</em> days",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "default": "#111111",
      "label": "Heading Main Text Color"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#CBD64A",
      "label": "Heading Accent Color"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Maximum products to show"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Featured Product Slider"
    }
  ]
}
{% endschema %}
