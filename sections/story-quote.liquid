{{ 'section-our-story.css' | asset_url | stylesheet_tag }}

<section id="section-{{ section.id }}" class="story-quote color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="story-quote__inner">
      <div class="story-quote__marks">“</div>
      {%- if section.settings.quote_text != blank -%}
        <h2 class="story-quote__text">{{ section.settings.quote_text }}</h2>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <div class="story-label" style="font-size: 1.4rem; letter-spacing: 0.2em; margin: 0;">{{ section.settings.tagline }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story 9. Quote Banner",
  "class": "section-story-quote",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    },
    {
      "type": "inline_richtext",
      "id": "quote_text",
      "label": "Quote Text",
      "default": "CHAMPIONS AREN'T BUILT OVERNIGHT. THEY'RE BUILT THROUGH REPETITION."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline / Accent Text",
      "default": "BUILT FOR THE REPEAT."
    }
  ],
  "presets": [
    {
      "name": "Story 9. Quote Banner"
    }
  ]
}
{% endschema %}
