    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "flag",
      "name": "EU Country Flag",
      "settings": [
        {
          "type": "text",
          "id": "country_name",
          "default": "Germany",
          "label": "Country Name"
        },
        {
          "type": "text",
          "id": "flag_emoji",
          "default": "🇩🇪",
          "label": "Flag Emoji"
        },
        {
          "type": "image_picker",
          "id": "flag_image",
          "label": "Custom Flag Image (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KØRĒ Footer"
    }
  ]
