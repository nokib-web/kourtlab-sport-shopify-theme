      "default": 25
    },
    {
      "type": "header",
      "content": "Font Size Controls"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Column Headings Font Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "link_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
