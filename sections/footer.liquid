{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0A0A0A' }} !important;
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 24 }}px;
    position: relative;
    overflow: hidden;
    --footer-heading-font-size: {{ section.settings.heading_font_size | default: 18 }}px;
    --footer-link-font-size: {{ section.settings.link_font_size | default: 17 }}px;
    --footer-body-font-size: {{ section.settings.body_font_size | default: 17 }}px;
  }

  {% if section.settings.bg_image != blank %}
    .footer-{{ section.id }}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2400 }}');
      background-size: cover;
      background-position: center;
      opacity: {{ section.settings.bg_image_opacity | default: 25 | divided_by: 100.0 }};
      pointer-events: none;
      z-index: 1;
    }
  {% endif %}

  .footer-{{ section.id }} .kore-footer__container {
    position: relative;
    z-index: 2;
  }
{%- endstyle -%}

<footer class="footer kore-footer footer-{{ section.id }}">
  <div class="kore-footer__container">
    <div class="kore-footer__grid">
      {%- comment -%} Column 1: Brand Info (Leftmost) {%- endcomment -%}
      <div class="kore-footer__col kore-footer__col--brand">
        <div class="kore-footer__logo-wrap">
          {%- if section.settings.footer_logo != blank -%}
            <img
              src="{{ section.settings.footer_logo | image_url: width: 400 }}"
              alt="{{ shop.name }}"
              class="kore-footer__logo-img"
              style="max-width: {{ section.settings.footer_logo_width | default: 160 }}px;"
              loading="lazy"
            >
          {%- else -%}
            <div class="kore-footer__logo-text">KOURTLAB<span>®</span></div>
          {%- endif -%}

          {%- if section.settings.subheading != blank -%}
            <div class="kore-footer__brand-subheading" style="color: {{ section.settings.subheading_color | default: '#CBD64A' }} !important;">
              {{ section.settings.subheading }}
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.description != blank -%}
          <div class="kore-footer__brand-desc">
            {{ section.settings.description }}
          </div>
        {%- else -%}
          <div class="kore-footer__brand-desc">
            <p>Premium performance apparel and essentials for the modern athlete. Engineered to perform on court. Designed to live in.</p>
          </div>
        {%- endif -%}

        {%- if section.settings.location_info != blank -%}
          <div class="kore-footer__location-info">
            {{ section.settings.location_info | newline_to_br }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <div class="kore-footer__social-links">
            {%- assign has_any_social = false -%}

            {%- if settings.social_instagram_link != blank -%}
              {%- assign has_any_social = true -%}
              <a href="{{ settings.social_instagram_link }}" class="kore-footer__social-icon" aria-label="Instagram" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            {%- endif -%}

            {%- if settings.social_tiktok_link != blank -%}
              {%- assign has_any_social = true -%}
              <a href="{{ settings.social_tiktok_link }}" class="kore-footer__social-icon" aria-label="TikTok" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743l-.002-.001.002.001a2.895 2.895 0 0 1 3.183-4.51v-3.5a6.329 6.329 0 0 0-5.394 2.378 6.338 6.338 0 0 0 .866 8.528 6.328 6.328 0 0 0 8.046.223 6.336 6.336 0 0 0 2.215-4.836V8.65a8.217 8.217 0 0 0 4.75 1.503V6.708a4.8 4.8 0 0 1-1.25-.022z"/>
                </svg>
              </a>
            {%- endif -%}

            {%- if settings.social_youtube_link != blank -%}
              {%- assign has_any_social = true -%}
              <a href="{{ settings.social_youtube_link }}" class="kore-footer__social-icon" aria-label="YouTube" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
                </svg>
              </a>
            {%- endif -%}

            {%- if settings.social_facebook_link != blank -%}
              {%- assign has_any_social = true -%}
              <a href="{{ settings.social_facebook_link }}" class="kore-footer__social-icon" aria-label="Facebook" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </a>
            {%- endif -%}

            {%- comment -%} If no social media links are configured in Theme Settings yet, display default Instagram, TikTok & YouTube icons {%- endcomment -%}
            {%- if has_any_social == false -%}
              <a href="https://instagram.com" class="kore-footer__social-icon" aria-label="Instagram" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
              <a href="https://tiktok.com" class="kore-footer__social-icon" aria-label="TikTok" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743l-.002-.001.002.001a2.895 2.895 0 0 1 3.183-4.51v-3.5a6.329 6.329 0 0 0-5.394 2.378 6.338 6.338 0 0 0 .866 8.528 6.328 6.328 0 0 0 8.046.223 6.336 6.336 0 0 0 2.215-4.836V8.65a8.217 8.217 0 0 0 4.75 1.503V6.708a4.8 4.8 0 0 1-1.25-.022z"/>
                </svg>
              </a>
              <a href="https://youtube.com" class="kore-footer__social-icon" aria-label="YouTube" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
                </svg>
              </a>
            {%- endif -%}

            {%- assign contact_email = section.settings.contact_email | default: 'info@kourtlab.com' -%}
            {%- if contact_email != blank -%}
              <a href="mailto:{{ contact_email }}" class="kore-footer__social-icon" aria-label="Email">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Column 2: SHOP Menu {%- endcomment -%}
      <div class="kore-footer__col">
        <h3 class="kore-footer__col-heading">{{ section.settings.menu_1_heading | default: 'SHOP' }}</h3>
        <ul class="kore-footer__menu-list list-unstyled">
          {%- assign menu_1 = section.settings.menu_1 -%}
          {%- if menu_1 != blank and linklists[menu_1].links.size > 0 -%}
            {%- for link in linklists[menu_1].links -%}
              <li><a href="{{ link.url }}" class="kore-footer__menu-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/collections/men" class="kore-footer__menu-link">Men</a></li>
            <li><a href="/collections/women" class="kore-footer__menu-link">Women</a></li>
            <li><a href="/collections/accessories" class="kore-footer__menu-link">Accessories</a></li>
            <li><a href="/collections/best-sellers" class="kore-footer__menu-link">Best Sellers</a></li>
            <li><a href="/collections/all" class="kore-footer__menu-link">New Arrivals</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Column 3: COMPANY Menu {%- endcomment -%}
      <div class="kore-footer__col">
        <h3 class="kore-footer__col-heading">{{ section.settings.menu_2_heading | default: 'COMPANY' }}</h3>
        <ul class="kore-footer__menu-list list-unstyled">
          {%- assign menu_2 = section.settings.menu_2 -%}
          {%- if menu_2 != blank and linklists[menu_2].links.size > 0 -%}
            {%- for link in linklists[menu_2].links -%}
              <li><a href="{{ link.url }}" class="kore-footer__menu-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/our-story" class="kore-footer__menu-link">Our Story</a></li>
            <li><a href="/pages/the-founding-1000" class="kore-footer__menu-link">The Founding 1000</a></li>
            <li><a href="/pages/sustainability" class="kore-footer__menu-link">Sustainability</a></li>
            <li><a href="/pages/careers" class="kore-footer__menu-link">Careers</a></li>
            <li><a href="/pages/contact" class="kore-footer__menu-link">Contact</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Column 4: SUPPORT Menu {%- endcomment -%}
      <div class="kore-footer__col">
        <h3 class="kore-footer__col-heading">{{ section.settings.menu_3_heading | default: 'SUPPORT' }}</h3>
        <ul class="kore-footer__menu-list list-unstyled">
          {%- assign menu_3 = section.settings.menu_3 -%}
          {%- if menu_3 != blank and linklists[menu_3].links.size > 0 -%}
            {%- for link in linklists[menu_3].links -%}
              <li><a href="{{ link.url }}" class="kore-footer__menu-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/policies/shipping-policy" class="kore-footer__menu-link">Shipping & Returns</a></li>
            <li><a href="/pages/faq" class="kore-footer__menu-link">FAQ</a></li>
            <li><a href="/pages/size-guide" class="kore-footer__menu-link">Size Guide</a></li>
            <li><a href="/policies/privacy-policy" class="kore-footer__menu-link">Privacy Policy</a></li>
            <li><a href="/policies/terms-of-service" class="kore-footer__menu-link">Terms of Service</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Column 5: European Union Shipping Info & Country Flags {%- endcomment -%}
      <div class="kore-footer__col kore-footer__col--eu">
        <div class="kore-footer__eu-header">
          <h3 class="kore-footer__col-heading">{{ section.settings.eu_heading | default: 'AVAILABLE IN THE EUROPEAN UNION' }}</h3>
          <span class="kore-footer__eu-flag-icon">🇪🇺</span>
        </div>

        {%- if section.settings.eu_subheading != blank -%}
          <p class="kore-footer__eu-subheading">{{ section.settings.eu_subheading }}</p>
        {%- endif -%}

        {%- comment -%} Circular Country Flags Grid {%- endcomment -%}
        <div class="kore-footer__flags-grid">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'flag' -%}
                <span class="kore-flag" title="{{ block.settings.country_name }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.flag_image != blank -%}
                    <img src="{{ block.settings.flag_image | image_url: width: 60 }}" alt="{{ block.settings.country_name }}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
                  {%- else -%}
                    {{ block.settings.flag_emoji | default: '🇪🇺' }}
                  {%- endif -%}
                </span>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <span class="kore-flag" title="Germany">🇩🇪</span>
            <span class="kore-flag" title="France">🇫🇷</span>
            <span class="kore-flag" title="Italy">🇮🇹</span>
            <span class="kore-flag" title="Spain">🇪🇸</span>
            <span class="kore-flag" title="Netherlands">🇳🇱</span>
            <span class="kore-flag" title="Belgium">🇧🇪</span>
            <span class="kore-flag" title="Sweden">🇸🇪</span>
            <span class="kore-flag" title="Austria">🇦🇹</span>
            <span class="kore-flag" title="Finland">🇫🇮</span>
            <span class="kore-flag" title="Ireland">🇮🇪</span>
            <span class="kore-flag" title="Portugal">🇵🇹</span>
            <span class="kore-flag kore-flag--more" title="More EU countries">+</span>
          {%- endif -%}
        </div>

        {%- if section.settings.eu_footer_text != blank -%}
          <p class="kore-footer__eu-footer-text">{{ section.settings.eu_footer_text }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Bottom Bar (Copyright & Bottom Tagline) {%- endcomment -%}
    <div class="kore-footer__bottom-bar">
      <div class="kore-footer__copyright">
        {{ section.settings.copyright_text | default: '© 2026 KOURTLAB. ALL RIGHTS RESERVED.' }}
      </div>
      <div class="kore-footer__bottom-tagline">
        {{ section.settings.bottom_tagline | default: 'BUILT FOR REPEAT.' }}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
