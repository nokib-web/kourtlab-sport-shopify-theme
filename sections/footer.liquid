      "label": "Brand Description Paragraph"
    },
    {
      "type": "textarea",
      "id": "location_info",
      "default": "CURAÇAO, DUTCH CARIBBEAN\n12.1696° N, 68.9900° W",
      "label": "Location & Coordinates Info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Show Social Media Icons"
    },
    {
      "type": "text",
      "id": "contact_email",
      "default": "info@kourtlab.com",
      "label": "Contact Email Address"
    },
    {
      "type": "header",
      "content": "Menu Column 1 (SHOP)"
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "default": "SHOP",
      "label": "Menu 1 Heading"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "default": "main-menu",
      "label": "Menu 1 Selection"
    },
    {
      "type": "header",
      "content": "Menu Column 2 (COMPANY)"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "default": "COMPANY",
      "label": "Menu 2 Heading"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "default": "footer",
      "label": "Menu 2 Selection"
    },
    {
      "type": "header",
      "content": "Menu Column 3 (SUPPORT)"
    },
    {
      "type": "text",
      "id": "menu_3_heading",
      "default": "SUPPORT",
      "label": "Menu 3 Heading"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu 3 Selection"
    },
    {
      "type": "header",
      "content": "EU Shipping Column"
    },
    {
      "type": "text",
      "id": "eu_heading",
      "default": "AVAILABLE IN THE EUROPEAN UNION",
      "label": "EU Section Heading"
    },
    {
      "type": "text",
      "id": "eu_subheading",
      "default": "We ship to all EU member states.",
      "label": "EU Subheading / Description"
    },
    {
      "type": "text",
      "id": "eu_footer_text",
      "default": "And all other EU countries.",
      "label": "EU Bottom Note"
    },
    {
      "type": "header",
