{{ 'section-founding-members.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="founding-cta color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if section.settings.bg_image != blank %} founding-section-has-bg{% endif %}">
  {%- if section.settings.bg_image != blank -%}
    <div class="founding-section-bg">
      <img
        src="{{ section.settings.bg_image | image_url: width: 2200 }}"
        alt="{{ section.settings.heading | escape }}"
        loading="lazy"
        class="founding-section-bg-img"
      >
    </div>
    <div
      class="founding-section-overlay"
      style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    ></div>
  {%- else -%}
    <div class="story-cta__bg-splash"></div>
  {%- endif -%}

  <div class="{% if section.settings.full_width %}page-width--full{% else %}page-width{% endif %}">
    <div class="founding-cta__inner">
      <div class="founding-cta__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="founding-cta__title">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subtext != blank -%}
          <p class="founding-cta__sub">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>

      <div class="founding-cta__actions">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link }}" class="founding-btn founding-btn--lime">
            {{ section.settings.button_1_label }} &rarr;
          </a>
        {%- endif -%}

        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link }}" class="founding-btn founding-btn--outline">
            {{ section.settings.button_2_label }} &rarr;
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founding 4. CTA Banner",
  "class": "section-founding-cta",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-5"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 65
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "ARE YOU BUILT FOR REPEAT<span>?</span>"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Join Justin, Marco, Sofia, Lena & Daan on court."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 Label",
      "default": "SHOP COLLECTION"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 Label",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Founding 4. CTA Banner"
    }
  ]
}
{% endschema %}
