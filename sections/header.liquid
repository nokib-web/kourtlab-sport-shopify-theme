    <button type="button" class="kore-mobile-dock__icon kore-mobile-dock__menu-btn link focus-inset" onclick="var hd=document.querySelector('header-drawer > details');if(hd){if(hd.hasAttribute('open')){document.querySelectorAll('header-drawer details').forEach(function(el){el.removeAttribute('open');el.classList.remove('menu-opening');});document.querySelectorAll('header-drawer .submenu-open').forEach(function(el){el.classList.remove('submenu-open');});document.body.classList.remove('overflow-hidden-mobile');}else{hd.setAttribute('open','');document.body.classList.add('overflow-hidden-mobile');}}" aria-label="Toggle Menu">
