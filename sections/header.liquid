<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  :root {
    --nav-active-color: {{ section.settings.nav_active_color | default: '#CBD64A' }};
  }

  .header__menu-item {
    font-size: {{ section.settings.menu_font_size | default: 14 }}px !important;
    font-weight: {{ section.settings.menu_font_weight | default: '600' }} !important;
    text-transform: {{ section.settings.menu_text_transform | default: 'uppercase' }} !important;
    letter-spacing: {{ section.settings.menu_letter_spacing | default: '0.05em' }} !important;
  }

  /* ── Active top-level nav link (current page) ── */
  /* Dawn puts aria-current="page" on the <a> and class="header__active-menu-item" on the inner <span> */
  .header__active-menu-item,
  .header__menu-item[aria-current="page"],
  a[aria-current="page"] .header__active-menu-item {
    color: var(--nav-active-color) !important;
  }

  /* ── Hover state for top-level nav items ── */
  .header__menu-item:hover .header__active-menu-item,
  .header__menu-item:hover > span {
    color: var(--nav-active-color) !important;
  }

  {%- if section.settings.nav_hover_underline -%}
  .header__menu-item:hover > span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  {%- endif -%}

  /* ── Active mega menu column title (childlink.current) ── */
  .mega-menu__column-title.mega-menu__link--active {
    color: var(--nav-active-color) !important;
    font-weight: 700 !important;
  }

  /* ── Active mega menu sublink (grandchildlink.current) ── */
  .mega-menu__sublink.mega-menu__link--active {
    color: var(--nav-active-color) !important;
    font-weight: 700 !important;
    text-decoration: none !important;
  }

  /* ── Hover on all mega menu links ── */
  .mega-menu__column-title:hover,
  .mega-menu__sublink:hover {
    color: var(--nav-active-color) !important;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }
</style>

{%- style -%}
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .header--full-width {
    max-width: 100% !important;
  }

  /* Default logo display for all pages (only main logo visible by default) */
  .header__heading-logo--overlay {
    display: none !important;
  }

  .header__heading-logo--main {
    display: block !important;
  }

{%- assign has_dark_hero = false -%}
{%- if request.page_type == 'index' or page.handle == 'about-kourtlab' or page.handle == 'contact' or request.page_type == '404' -%}
  {%- assign has_dark_hero = true -%}
{%- endif -%}

{%- if has_dark_hero -%}
  /* Hide announcement bar on homepage hero for pure editorial look */
  .announcement-bar-section,
  .shopify-section-announcement-bar,
  #shopify-section-sections--{{ section.id }}__announcement-bar {
    display: none !important;
  }

  /* ── Transparent Header Overlay on Hero Images ── */
  .section-header {
    position: absolute !important;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 100;
  }

  /* Top State (over hero image): Transparent background, white text & icons */
  .section-header:not(.scrolled-past-header) .header-wrapper {
    background-color: transparent !important;
    background-image: none !important;
    border-bottom: none !important;
    box-shadow: none !important;
    transition: background-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                backdrop-filter 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .section-header:not(.scrolled-past-header) .header__menu-item,
  .section-header:not(.scrolled-past-header) .header__heading-link,
  .section-header:not(.scrolled-past-header) .header__icon,
  .section-header:not(.scrolled-past-header) .header__icon .icon,
  .section-header:not(.scrolled-past-header) .header__heading-link span,
  .section-header:not(.scrolled-past-header) .header__menu-item span,
  .section-header:not(.scrolled-past-header) .header__inline-menu summary,
  .section-header:not(.scrolled-past-header) .header__inline-menu a {
    color: #ffffff !important;
  }

  .section-header:not(.scrolled-past-header) .header__active-menu-item {
    color: #cbd64a !important;
  }

  /* Dropdown & Mega Menu for Top State (over dark hero photo): Dark Glass Background & White/Lime Text */
  .section-header:not(.scrolled-past-header) .mega-menu__content,
  .section-header:not(.scrolled-past-header) .header__submenu {
    background-color: rgba(10, 10, 10, 0.95) !important;
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 0 !important;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6) !important;
  }

  .section-header:not(.scrolled-past-header) .mega-menu__column-title,
  .section-header:not(.scrolled-past-header) .mega-menu__promo-title,
  .section-header:not(.scrolled-past-header) .header__submenu .header__menu-item {
    color: #ffffff !important;
  }

  .section-header:not(.scrolled-past-header) .mega-menu__sublink {
    color: rgba(255, 255, 255, 0.72) !important;
  }

  .section-header:not(.scrolled-past-header) .mega-menu__sublink:hover,
  .section-header:not(.scrolled-past-header) .mega-menu__column-title:hover,
  .section-header:not(.scrolled-past-header) .header__submenu .header__menu-item:hover {
    color: #cbd64a !important;
    background-color: rgba(255, 255, 255, 0.05) !important;
  }

  /* Dual Logo Display & Auto Inversion over Dark Hero */
  .section-header:not(.scrolled-past-header) .header__heading-logo--main {
    display: none !important;
  }
  .section-header:not(.scrolled-past-header) .header__heading-logo--overlay {
    display: block !important;
    filter: none !important;
  }
{%- else -%}
  /* Standard Header for Light Canvas Pages (e.g. founding-member, collections, products) */
  .section-header .header-wrapper {
    background-color: #ffffff !important;
    border-bottom: none !important;
  }

  .section-header .header__menu-item,
  .section-header .header__heading-link,
  .section-header .header__icon,
  .section-header .header__icon .icon,
  .section-header .header__heading-link span,
  .section-header .header__menu-item span,
  .section-header .header__inline-menu summary,
  .section-header .header__inline-menu a {
    color: #0a0a0a !important;
  }

  .section-header .header__heading-logo--main {
    display: none !important;
  }

  .section-header .header__heading-logo--overlay {
    display: block !important;
    filter: brightness(0) !important;
  }

  .section-header .mega-menu__content,
  .section-header .header__submenu {
    background-color: rgba(255, 255, 255, 0.98) !important;
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    border-radius: 0 !important;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08) !important;
  }

  .section-header .mega-menu__column-title,
  .section-header .mega-menu__promo-title,
  .section-header .header__submenu .header__menu-item {
    color: #0a0a0a !important;
  }
{%- endif -%}

  /* Scrolled State (over white canvas): White glass background, dark text & icons */
  .section-header.scrolled-past-header {
    position: fixed !important;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    animation: headerSlideDown 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .section-header.scrolled-past-header .header-wrapper {
    background-color: rgba(255, 255, 255, 0.95) !important;
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    border-bottom: none !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .section-header.scrolled-past-header .header__menu-item,
  .section-header.scrolled-past-header .header__heading-link,
  .section-header.scrolled-past-header .header__icon,
  .section-header.scrolled-past-header .header__icon .icon,
  .section-header.scrolled-past-header .header__heading-link span,
  .section-header.scrolled-past-header .header__menu-item span,
  .section-header.scrolled-past-header .header__inline-menu summary,
  .section-header.scrolled-past-header .header__inline-menu a {
    color: #0a0a0a !important;
  }

  .section-header.scrolled-past-header .header__heading-logo--main {
    display: none !important;
  }

  .section-header.scrolled-past-header .header__heading-logo--overlay {
    display: block !important;
    filter: brightness(0) !important;
  }

  /* Dropdown & Mega Menu for Scrolled State (over white canvas): White Glass Background & Dark Text */
  .section-header.scrolled-past-header .mega-menu__content,
  .section-header.scrolled-past-header .header__submenu {
    background-color: rgba(255, 255, 255, 0.98) !important;
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    border-radius: 0 !important;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08) !important;
  }

  .section-header.scrolled-past-header .mega-menu__column-title,
  .section-header.scrolled-past-header .mega-menu__promo-title,
  .section-header.scrolled-past-header .header__submenu .header__menu-item {
    color: #0a0a0a !important;
  }

  .section-header.scrolled-past-header .mega-menu__sublink {
    color: rgba(10, 10, 10, 0.72) !important;
  }

  .section-header.scrolled-past-header .mega-menu__sublink:hover,
  .section-header.scrolled-past-header .mega-menu__column-title:hover,
  .section-header.scrolled-past-header .header__submenu .header__menu-item:hover {
    color: #cbd64a !important;
    background-color: rgba(0, 0, 0, 0.03) !important;
  }

  @keyframes headerSlideDown {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(0);
    }
  }

  /* ── 1:1 On-Running Style Full-Width Mobile Bottom Dock & Top-Left Logo ── */
  @media screen and (max-width: 989px) {
    /* Ensure header wrapper does not become sticky or animate */
    .shopify-section-group-header-group,
    sticky-header,
    .shopify-section-header-sticky,
    .shopify-section-header-hidden {
      position: static !important;
      top: auto !important;
      visibility: visible !important;
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }

    {%- if has_dark_hero -%}
      .section-header {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        width: 100% !important;
        z-index: 100 !important;
        background: transparent !important;
      }
      .section-header .header-wrapper {
        background-color: transparent !important;
        background-image: none !important;
        border: none !important;
        box-shadow: none !important;
      }
    {%- else -%}
      .section-header {
        position: static !important;
      }
    {%- endif -%}

    /* Hide top header right icons and top hamburger summary button on mobile */
    .header .header__icons,
    .header > header-drawer > details > summary {
      display: none !important;
    }

    /* ── Full-Screen Menu Drawer ── */
    header-drawer {
      display: block !important;
    }

    /* Target .menu-drawer directly — override all Dawn hiding/positioning */
    header-drawer details[open] > .menu-drawer {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100vw !important;
      height: 100dvh !important;       /* override Dawn's calc(100vh - 100%) = 0px bug */
      transform: translateX(0) !important;
      visibility: visible !important;
      opacity: 1 !important;
      display: block !important;
      z-index: 99999999 !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
      background-color: #ffffff !important;
    }

    /* ── Inner container — no overflow:hidden so content renders ── */
    header-drawer .menu-drawer__inner-container {
      display: block !important;
      padding: 0 !important;
      background-color: #ffffff !important;
    }

    header-drawer .menu-drawer__header-logo {
      padding: 24px 24px 0 24px !important;
      margin-bottom: 2rem !important;
    }

    /* Navigation area padding — only inside drawer */
    header-drawer .menu-drawer__navigation {
      padding: 0 24px 120px 24px !important;
    }

    /* ── MAIN NAV LINKS — large bold like on.com ── */
    header-drawer .menu-drawer__menu > li > a.menu-drawer__menu-item,
    header-drawer .menu-drawer__menu > li > details > summary.menu-drawer__menu-item {
      font-family: var(--font-heading-family), sans-serif !important;
      font-size: 2.4rem !important;
      font-weight: 900 !important;
      letter-spacing: -0.02em !important;
      color: #0a0a0a !important;
      padding: 0.5rem 0 !important;
      border: none !important;
      background: transparent !important;
      line-height: 1.15 !important;
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      width: 100% !important;
      text-decoration: none !important;
    }

    /* ── + / − toggle icons ── */
    header-drawer .menu-drawer__menu > li > details > summary.menu-drawer__menu-item::after {
      content: '+' !important;
      font-size: 1.8rem !important;
      font-weight: 300 !important;
      line-height: 1 !important;
      flex-shrink: 0 !important;
    }

    header-drawer .menu-drawer__menu > li > details[open] > summary.menu-drawer__menu-item::after {
      content: '−' !important;
    }

    /* ── LEVEL 2 SUBMENU: Slide-in panel (← Shop Now) ── */
    header-drawer .menu-drawer__submenu {
      background-color: #ffffff !important;
      padding: 0 !important;
    }

    header-drawer .menu-drawer__inner-submenu {
      height: 100% !important;
      overflow-x: hidden !important;
      overflow-y: auto !important;
      padding: 0 24px 100px 24px !important;
      box-sizing: border-box !important;
    }

    /* ── BACK BUTTON ← (Only in Level 2 panel) ── */
    header-drawer .menu-drawer__close-button {
      display: flex !important;
      align-items: center !important;
      gap: 10px !important;
      font-family: var(--font-heading-family), sans-serif !important;
      font-size: 1.8rem !important;
      font-weight: 800 !important;
      color: #0a0a0a !important;
      text-transform: none !important;
      letter-spacing: -0.01em !important;
      padding: 24px 0 20px 0 !important;
      border: none !important;
      background: transparent !important;
      cursor: pointer !important;
      width: 100% !important;
      text-align: left !important;
      box-sizing: border-box !important;
    }

    header-drawer .menu-drawer__close-button::before {
      content: '←' !important;
      font-size: 2rem !important;
      color: #0a0a0a !important;
      font-weight: 400 !important;
    }

    header-drawer .menu-drawer__close-button .svg-wrapper {
      display: none !important;
    }

    /* ── LEVEL 3 SUBMENU: INLINE ACCORDION ON SAME PAGE ── */
    /* Nested submenu inside Level 2 does NOT slide, it expands inline */
    header-drawer .menu-drawer__submenu .menu-drawer__submenu {
      position: static !important;
      transform: none !important;
      visibility: visible !important;
      opacity: 1 !important;
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      background: transparent !important;
      padding: 0 !important;
      display: none !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      bottom: auto !important;
      transition: none !important;
    }

    /* Show inline when details is open */
    header-drawer .menu-drawer__submenu details[open] > .menu-drawer__submenu {
      display: block !important;
    }

    header-drawer .menu-drawer__submenu .menu-drawer__submenu .menu-drawer__inner-submenu {
      padding: 4px 0 12px 16px !important;
      height: auto !important;
      min-height: 0 !important;
      background: transparent !important;
      overflow: visible !important;
    }

    /* Hide back button in Level 3 nested inline submenu */
    header-drawer .menu-drawer__submenu .menu-drawer__submenu .menu-drawer__close-button {
      display: none !important;
    }

    /* Prevent parent Level 2 menu container from hiding when Level 3 details opens */
    header-drawer .menu-drawer__submenu .submenu-open,
    header-drawer .menu-drawer__submenu.submenu-open {
      visibility: visible !important;
    }

    /* ── TYPOGRAPHY FOR ALL LEVELS ── */
    /* Level 1 links */
    header-drawer .menu-drawer__menu > li > a.menu-drawer__menu-item,
    header-drawer .menu-drawer__menu > li > details > summary.menu-drawer__menu-item {
      font-family: var(--font-heading-family), sans-serif !important;
      font-size: 2.4rem !important;
      font-weight: 900 !important;
      letter-spacing: -0.02em !important;
      color: #0a0a0a !important;
      line-height: 1.15 !important;
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      width: 100% !important;
      text-decoration: none !important;
      background: transparent !important;
      border: none !important;
      padding: 0.5rem 0 !important;
    }

    /* Level 2 links (inside ← Shop Now panel, e.g., Men, Women, Accessories) */
    header-drawer .menu-drawer__submenu .menu-drawer__menu > li > details > summary.menu-drawer__menu-item,
    header-drawer .menu-drawer__submenu .menu-drawer__menu > li > a.menu-drawer__menu-item {
      font-family: var(--font-heading-family), sans-serif !important;
      font-size: 2rem !important;
      font-weight: 800 !important;
      letter-spacing: -0.01em !important;
      color: #0a0a0a !important;
      padding: 0.5rem 0 !important;
      line-height: 1.2 !important;
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      width: 100% !important;
      text-decoration: none !important;
      background: transparent !important;
      border: none !important;
    }

    /* Level 3 inline links (e.g., Tops & Tees, Shorts & Bottoms) */
    header-drawer .menu-drawer__submenu .menu-drawer__submenu .menu-drawer__menu-item {
      font-family: var(--font-heading-family), sans-serif !important;
      font-size: 1.35rem !important;
      font-weight: 700 !important;
      color: #333333 !important;
      letter-spacing: 0 !important;
      padding: 0.4rem 0 !important;
      display: block !important;
      text-decoration: none !important;
    }

    /* Hide Dawn's SVG arrows inside drawer only */
    header-drawer .menu-drawer__navigation .svg-wrapper {
      display: none !important;
    }

    /* ── + / − TOGGLE ICONS ── */
    header-drawer details > summary.menu-drawer__menu-item::after {
      content: '+' !important;
      font-size: 1.8rem !important;
      font-weight: 300 !important;
      line-height: 1 !important;
      flex-shrink: 0 !important;
    }

    header-drawer details[open] > summary.menu-drawer__menu-item::after {
      content: '−' !important;
    }

    /* Hover styling */
    header-drawer .menu-drawer__menu-item:hover {
      background: transparent !important;
      color: #cbd64a !important;
    }

    /* Hide utility box & account */
    header-drawer .menu-drawer__utility-links {
      display: none !important;
    }

    header-drawer .menu-drawer__account {
      display: none !important;
    }

    /* Toggle Hamburger ↔ Close X in bottom dock */
    body:has(header-drawer > details[open]) .icon-hamburger-dock {
      display: none !important;
    }

    body:has(header-drawer > details[open]) .icon-close-dock {
      display: inline-block !important;
    }

    body:not(:has(header-drawer > details[open])) .icon-close-dock {
      display: none !important;
    }

    body:not(:has(header-drawer > details[open])) .icon-hamburger-dock {
      display: inline-block !important;
    }

    /* When drawer is open — dock turns white to match the white drawer menu */
    body:has(header-drawer > details[open]) .kore-mobile-dock__inner {
      background-color: rgba(255, 255, 255, 0.98) !important;
      border-top: 1px solid rgba(0, 0, 0, 0.08) !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }

    body:has(header-drawer > details[open]) .kore-mobile-dock__icon,
    body:has(header-drawer > details[open]) .header__icon--search {
      color: #0a0a0a !important;
    }

    /* Dock Search Icon Styling */
    .kore-mobile-dock .header__search {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .kore-mobile-dock .header__search details {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .kore-mobile-dock .header__icon--search {
      color: #ffffff !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      position: relative !important;
      width: 44px !important;
      height: 44px !important;
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      cursor: pointer !important;
    }

    .kore-mobile-dock .header__icon--search .header__icon-close {
      display: none !important;
    }

    /* Full-Width Sticky Bottom Navigation Dock (100% Fixed at Bottom) */
    .kore-mobile-dock {
      position: fixed !important;
      bottom: 0 !important;
      top: auto !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      height: 58px !important;
      z-index: 999999999 !important;
      display: block !important;
      transform: none !important;
    }

    .kore-mobile-dock__inner {
      display: flex !important;
      align-items: center !important;
      justify-content: space-around !important;
      width: 100% !important;
      height: 100% !important;
      padding: 0 12px !important;
      box-sizing: border-box !important;
      background-color: rgba(10, 10, 10, 0.92) !important;
      backdrop-filter: blur(20px) saturate(180%) !important;
      -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
      border-top: 1px solid rgba(255, 255, 255, 0.12) !important;
    }

    /* Light Canvas / Scrolled Dock State */
    .section-header.scrolled-past-header ~ .kore-mobile-dock .kore-mobile-dock__inner,
    body:has(.scrolled-past-header) .kore-mobile-dock__inner {
      background-color: rgba(255, 255, 255, 0.98) !important;
      border-top: 1px solid rgba(0, 0, 0, 0.08) !important;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.06) !important;
    }

    .kore-mobile-dock__icon {
      color: #ffffff !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      position: relative !important;
      width: 44px !important;
      height: 44px !important;
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      cursor: pointer !important;
      text-decoration: none !important;
    }

    .section-header.scrolled-past-header ~ .kore-mobile-dock .kore-mobile-dock__icon,
    body:has(.scrolled-past-header) .kore-mobile-dock__icon {
      color: #0a0a0a !important;
    }

    .kore-mobile-dock .svg-wrapper,
    .kore-mobile-dock svg {
      width: 20px !important;
      height: 20px !important;
      color: currentColor !important;
    }

    .kore-mobile-dock__icon--cart .svg-wrapper,
    .kore-mobile-dock__icon--cart svg,
    .kore-mobile-dock__icon--cart .icon-cart-empty,
    .kore-mobile-dock__icon--cart .icon-cart {
      width: 28px !important;
      height: 28px !important;
    }

    .kore-mobile-dock .cart-count-bubble {
      position: absolute !important;
      top: 4px !important;
      right: 4px !important;
      background-color: #cbd64a !important;
      color: #0a0a0a !important;
      font-weight: 900 !important;
      font-size: 0.7rem !important;
      width: 16px !important;
      height: 16px !important;
      border-radius: 50% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }
  }
{%- endstyle -%}

